[Unit]
Description=Relocate /var/lib/flatpak to /var/home/flatpak symlink (one-shot)
ConditionPathExists=/var/home/flatpak
ConditionPathIsSymbolicLink=!/var/lib/flatpak
After=local-fs.target
Before=flatpak-system-helper.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '[ -L /var/lib/flatpak ] || { [ -e /var/lib/flatpak ] && mv /var/lib/flatpak /var/lib/flatpak_del; }'
ExecStart=/bin/ln -sfn /var/home/flatpak /var/lib/flatpak
ExecStart=/bin/sh -c '[ "$(readlink -f /var/lib/flatpak)" = "/var/home/flatpak" ] && rm -rf /var/lib/flatpak_del; exit 0'

[Install]
WantedBy=multi-user.target
