[Unit]
Description=Align DayOS user settings with the UID 1000 account
After=local-fs.target systemd-sysusers.service
Before=nix-daemon.service
ConditionPathExists=/usr/libexec/dayos/apply-user-config.sh

[Service]
Type=oneshot
ExecStart=/usr/libexec/dayos/apply-user-config.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
