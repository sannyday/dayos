[Unit]
Description=One-time copy of /nix to /var/home/nix
ConditionPathExists=/nix
ConditionPathExists=!/var/home/nix
DefaultDependencies=no
After=systemd-remount-fs.service var-home.mount
Requires=var-home.mount
Before=local-fs.target nix.mount
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/cp -a /nix /var/home/nix
ExecStartPost=/bin/systemctl disable nix-copy.service

[Install]
WantedBy=local-fs.target
